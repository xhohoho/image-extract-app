{
  "name": "image-extract-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "npx wrangler d1 execute image-extract-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "npx wrangler d1 execute image-extract-db --remote --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240614.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.100.0"
  }
}
